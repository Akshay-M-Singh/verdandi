# Copy this file to .env and fill in what you need. Never commit .env.
#
# The only key the engine needs is an opencode Zen gateway key
# (https://opencode.ai/auth). You can also paste it into the app's
# onboarding screen, which stores it in the OS keychain.
OPENCODE_API_KEY=

# Optional: force a capture engine (auto | apple_vision | crossplatform).
# VERDANDI_OCR_ENGINE=auto

# Optional: use the packaged app's user config layer in a dev checkout.
# VERDANDI_USER_CONFIG=1

# --- Benchmark only (benchmark/README.md) --------------------------------
# The ACU comparison needs an Azure Content Understanding resource.
# AZURE_CU_ENDPOINT=
# AZURE_CU_KEY=
# AZURE_CU_COMPLETION=
# AZURE_CU_EMBEDDING=
# AZURE_CU_RATE_PAGE_STANDARD=
# AZURE_CU_RATE_CONTEXTUALIZATION=
# AZURE_CU_RATE_INPUT=
# AZURE_CU_RATE_CACHED_INPUT=
# AZURE_CU_RATE_OUTPUT=
# AZURE_CU_RATE_SOURCE=
# Kaggle credentials for downloading the public invoice dataset.
# KAGGLE_API_TOKEN=
