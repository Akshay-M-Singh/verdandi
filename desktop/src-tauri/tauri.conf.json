{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verdandi",
  "version": "1.1.0",
  "identifier": "ai.verdandi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 http://localhost:8787; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:8787 http://localhost:8787; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/engine"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MjY4MEU3QjhCNjhFNDQKUldSRWpyYTQ1NEFteGFyOVowMWVNQTFCdlFWcWZJRGY0cUpSUDh1RWpaVVdOckZCTGtueTVsNmoK",
      "endpoints": [
        "https://github.com/Akshay-M-Singh/verdandi-app/releases/latest/download/latest.json"
      ]
    }
  }
}
