{
  "identifier": "default",
  "description": "Main window: local UI only (the engine is a local sidecar, not a Tauri plugin).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "process:default",
    "updater:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.verdandi" },
        { "path": "$HOME/.verdandi/**" }
      ]
    }
  ]
}
